Options -Indexes
ErrorDocument 404 /portal/404.php
ErrorDocument 403 /portal/404.php

# El historial de Git no debe ser accesible desde el navegador
RedirectMatch 404 /\.git

<FilesMatch "^(config\.php|config\.example\.php|.*\.(sql|log|md|bak|ini|env))$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; frame-ancestors 'none'; form-action 'self'"
</IfModule>
